# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site (used in email links)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Claude: mentor matching and the booking-brief specificity check
# (optional; without it, both fall back to simple rules)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_CHECK_MODEL=claude-haiku-5-5

# Email via Resend (optional; without it, emails are skipped)
RESEND_API_KEY=
EMAIL_FROM=IITG Alumni Connect <connect@your-domain.org>

# Protects the daily reminder job; Vercel sends it automatically
CRON_SECRET=
